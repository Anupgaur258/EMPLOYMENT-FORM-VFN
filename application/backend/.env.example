# Backend-only environment variables. Copy to .env for local development.
PORT=5000
MONGODB_URI=

# Required for admin login. Use a unique random password and at least 32 random
# characters for JWT_SECRET. Never use these examples as production values.
ADMIN_PASSWORD=
JWT_SECRET=
CAPTCHA_SECRET=

# Exact public Pages URLs, comma-separated. Example:
# CLIENT_URL=https://your-public.pages.dev,https://your-admin.pages.dev
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Google Drive OAuth 2.0 (authorized user account). No service account keys.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
